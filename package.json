{
  "name": "ai-video-aggregation-platform",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:root && turbo run test --concurrency=1",
    "test:root": "vitest run scripts/verify-workspace.test.ts scripts/validate-compose.test.ts scripts/verify-lock.test.ts tests/e2e/contracts.spec.ts",
    "test:coverage": "turbo run test:coverage",
    "verify": "node scripts/verify.mjs",
    "preflight:wave1": "node scripts/wave1-preflight.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.0",
    "vitest": "4.1.11"
  }
}
