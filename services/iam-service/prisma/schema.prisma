generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id                          String            @id @default(dbgenerated("iam_uuid_v7()")) @db.Uuid
  email                       String            @unique
  passwordHash                String            @map("password_hash")
  status                      String            @default("ACTIVE")
  mfaEnabled                  Boolean           @default(false) @map("mfa_enabled")
  pendingTotpSecretCiphertext String?           @map("pending_totp_secret_ciphertext")
  totpSecretCiphertext        String?           @map("totp_secret_ciphertext")
  lastTotpTimeStep            BigInt?           @map("last_totp_time_step")
  recoveryGeneration          String?           @map("recovery_generation") @db.Uuid
  mfaFailureCount             Int               @default(0) @map("mfa_failure_count")
  mfaFailureWindowStartedAt   DateTime?         @map("mfa_failure_window_started_at")
  mfaLockedUntil              DateTime?         @map("mfa_locked_until")
  createdAt                   DateTime          @default(now()) @map("created_at")
  updatedAt                   DateTime          @updatedAt @map("updated_at")
  sessions                    AdminSession[]
  mfaChallenges               MfaChallenge[]
  recoveryCodes               MfaRecoveryCode[]
  roles                       AdminRole[]

  @@index([mfaLockedUntil])
  @@map("admin_users")
}

model AdminSession {
  id                    String    @id @default(dbgenerated("iam_uuid_v7()")) @db.Uuid
  adminId               String    @map("admin_id") @db.Uuid
  familyId              String    @map("family_id") @db.Uuid
  refreshTokenDigest    String    @unique @map("refresh_token_digest") @db.Char(64)
  deviceName            String    @map("device_name")
  expiresAt             DateTime  @map("expires_at")
  consumedAt            DateTime? @map("consumed_at")
  revokedAt             DateTime? @map("revoked_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  status                String    @default("ACTIVE")
  pendingKind           String?   @map("pending_kind")
  pendingChallengeId    String?   @map("pending_challenge_id") @db.Uuid
  pendingRecoveryCodeId String?   @map("pending_recovery_code_id") @db.Uuid
  pendingTotpTimeStep   BigInt?   @map("pending_totp_time_step")
  pendingPredecessorId  String?   @map("pending_predecessor_id") @db.Uuid
  pendingExpiresAt      DateTime? @map("pending_expires_at")
  admin                 AdminUser @relation(fields: [adminId], references: [id])

  @@index([adminId, revokedAt])
  @@index([familyId, revokedAt])
  @@index([status, pendingExpiresAt])
  @@map("admin_sessions")
}

model MfaChallenge {
  id                String    @id @default(dbgenerated("iam_uuid_v7()")) @db.Uuid
  adminId           String    @map("admin_id") @db.Uuid
  challengeDigest   String    @unique @map("challenge_digest") @db.Char(64)
  expiresAt         DateTime  @map("expires_at")
  attempts          Int       @default(0)
  consumedAt        DateTime? @map("consumed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  reservedSessionId String?   @map("reserved_session_id") @db.Uuid
  reservedUntil     DateTime? @map("reserved_until")
  admin             AdminUser @relation(fields: [adminId], references: [id])

  @@index([adminId, createdAt])
  @@map("mfa_challenges")
}

model MfaRecoveryCode {
  id                String    @id @default(dbgenerated("iam_uuid_v7()")) @db.Uuid
  adminId           String    @map("admin_id") @db.Uuid
  generation        String    @db.Uuid
  digest            String    @unique @db.Char(64)
  pepperVersion     String    @default("legacy-v1") @map("pepper_version")
  consumedAt        DateTime? @map("consumed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  admin             AdminUser @relation(fields: [adminId], references: [id])
  reservedSessionId String?   @map("reserved_session_id") @db.Uuid
  reservedUntil     DateTime? @map("reserved_until")

  @@index([adminId, generation, pepperVersion, consumedAt], map: "mfa_recovery_codes_admin_id_generation_pepper_version_consumed_")
  @@map("mfa_recovery_codes")
}

model Role {
  id          String           @id @default(dbgenerated("iam_uuid_v7()")) @db.Uuid
  name        String           @unique
  description String
  dataScope   String           @default("OWN") @map("data_scope")
  version     Int              @default(1)
  protected   Boolean          @default(false)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  admins      AdminRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("iam_uuid_v7()")) @db.Uuid
  key         String           @unique
  description String
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@map("permissions")
}

model AdminRole {
  adminId    String    @map("admin_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  assignedAt DateTime  @default(now()) @map("assigned_at")
  assignedBy String    @map("assigned_by") @db.Uuid
  admin      AdminUser @relation(fields: [adminId], references: [id])
  role       Role      @relation(fields: [roleId], references: [id])

  @@id([adminId, roleId])
  @@index([roleId])
  @@map("admin_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AuditEvent {
  id            String   @id @default(dbgenerated("iam_uuid_v7()")) @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  action        String
  resourceType  String   @map("resource_type")
  resourceId    String?  @map("resource_id")
  before        Json?
  after         Json?
  ipAddress     String   @map("ip_address")
  userAgent     String   @map("user_agent")
  traceId       String   @map("trace_id") @db.Char(32)
  correlationId String   @map("correlation_id") @db.Uuid
  causationId   String?  @map("causation_id") @db.Uuid
  occurredAt    DateTime @map("occurred_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([occurredAt])
  @@index([actorId, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
  @@map("audit_events")
}
