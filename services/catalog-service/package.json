    "test:coverage": "vitest run --coverage --exclude dist/**"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "@prisma/client": "7.10.0",
    "@repo/capability-schema": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/service-kit": "workspace:*",
    "ajv": "8.20.0",
    "fastify": "5.12.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.11",
    "prisma": "7.10.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
