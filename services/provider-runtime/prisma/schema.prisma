generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ProviderExecutionStatus {
  SUBMITTING
  ACCEPTED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
  RETRY_SCHEDULED
  AMBIGUOUS
}

enum ProviderAttemptAction {
  CREATE
  QUERY
  CANCEL
}

enum ProviderAttemptStatus {
  STARTED
  ACCEPTED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
  RETRY_SCHEDULED
  AMBIGUOUS
}

enum ProviderNextAction {
  NONE
  CREATE_RETRY
  RECONCILE
  POLL
}

enum CircuitStatus {
  CLOSED
  OPEN
  HALF_OPEN
}

model ProviderExecution {
  id                       String                  @id @db.Uuid
  taskId                   String                  @unique @db.Uuid
  capabilityVersionId      String                  @db.Uuid
  parametersSnapshotSha256 String                  @db.Char(64)
  providerId               String                  @db.Uuid
  modelCode                String                  @db.VarChar(160)
  idempotencyKey           String                  @db.VarChar(160)
  providerTaskId           String?                 @db.VarChar(512)
  status                   ProviderExecutionStatus @default(SUBMITTING)
  currentAttempt           Int                     @default(1)
  nextAction               ProviderNextAction      @default(NONE)
  nextAttemptAt            DateTime?               @db.Timestamptz(3)
  lastErrorCode            String?                 @db.VarChar(120)
  lastHttpStatus           Int?
  traceId                  String                  @db.Char(32)
  correlationId            String                  @db.Uuid
  leaseToken               String?                 @db.Char(64)
  leaseExpiresAt           DateTime?               @db.Timestamptz(3)
  version                  Int                     @default(0)
  createdAt                DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                @updatedAt @db.Timestamptz(3)
  attempts                 ProviderAttempt[]
  callbacks                CallbackInbox[]

  @@unique([providerId, providerTaskId])
  @@index([status, nextAttemptAt])
  @@index([providerId, modelCode, status])
  @@index([providerTaskId])
  @@index([updatedAt])
}

model ProviderAttempt {
  id             String                @id @db.Uuid
  executionId    String                @db.Uuid
  attemptNumber  Int
  action         ProviderAttemptAction
  status         ProviderAttemptStatus @default(STARTED)
  idempotencyKey String                @db.VarChar(160)
  providerTaskId String?               @db.VarChar(512)
  httpStatus     Int?
  errorCode      String?               @db.VarChar(120)
  leaseToken     String?               @db.Char(64)
  startedAt      DateTime              @db.Timestamptz(3)
  completedAt    DateTime?             @db.Timestamptz(3)
  execution      ProviderExecution     @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, attemptNumber])
  @@index([status, startedAt])
  @@index([providerTaskId])
}

model InboxMessage {
  id            String    @id @db.Uuid
  consumer      String    @db.VarChar(160)
  messageId     String    @db.VarChar(160)
  eventType     String    @db.VarChar(160)
  payloadSha256 String    @db.Char(64)
  receivedAt    DateTime  @db.Timestamptz(3)
  processedAt   DateTime? @db.Timestamptz(3)
  lastError     String?

  @@unique([consumer, messageId])
  @@index([consumer, processedAt, receivedAt])
}

model CallbackInbox {
  id              String            @id @db.Uuid
  providerEventId String            @unique @db.VarChar(256)
  executionId     String            @db.Uuid
  providerTaskId  String            @db.VarChar(512)
  sequence        Int
  payloadSha256   String            @db.Char(64)
  receivedAt      DateTime          @db.Timestamptz(3)
  processedAt     DateTime?         @db.Timestamptz(3)
  execution       ProviderExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, providerEventId])
  @@index([executionId, sequence])
  @@index([providerTaskId, sequence])
  @@index([processedAt, receivedAt])
}

model CircuitState {
  id                   String        @id @db.Uuid
  providerId           String        @db.Uuid
  modelCode            String        @db.VarChar(160)
  status               CircuitStatus @default(CLOSED)
  windowStartedAt      DateTime?     @db.Timestamptz(3)
  windowRequests       Int           @default(0)
  windowFailures       Int           @default(0)
  openedAt             DateTime?     @db.Timestamptz(3)
  openUntil            DateTime?     @db.Timestamptz(3)
  halfOpenProbeInFlight Boolean       @default(false)
  reasonCode           String?       @db.VarChar(120)
  version              Int           @default(0)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([providerId, modelCode])
  @@index([status, openUntil])
}

model OutboxEvent {
  id               String    @id @db.Uuid
  aggregateType    String    @db.VarChar(80)
  aggregateId      String    @db.Uuid
  eventType        String    @db.VarChar(160)
  eventVersion     Int
  deduplicationKey String?   @unique @db.VarChar(240)
  payload          Json
  headers          Json
  occurredAt       DateTime  @db.Timestamptz(3)
  availableAt      DateTime  @db.Timestamptz(3)
  publishedAt      DateTime? @db.Timestamptz(3)
  attempts         Int       @default(0)
  lastError        String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  @@index([publishedAt, availableAt])
  @@index([aggregateType, aggregateId, occurredAt])
}
