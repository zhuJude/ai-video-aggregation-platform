    "prisma:validate": "prisma validate",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "7.10.0",
    "ali-oss": "6.23.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "prisma": "7.10.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
