{
  "name": "@repo/asset-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node dist/src/main.js",
    "build": "node scripts/prisma-generate.mjs && tsc -p tsconfig.json",
    "lint": "node scripts/prisma-generate.mjs && eslint src test",
    "typecheck": "node scripts/prisma-generate.mjs && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude dist/**",
    "test:coverage": "vitest run --coverage --exclude dist/**",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@alicloud/credentials": "2.4.7",
    "@alicloud/kms20160120": "3.3.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@repo/contracts": "workspace:*",
    "ali-oss": "6.23.0",
    "fastify": "5.12.1",
    "jose": "6.2.12",
    "reflect-metadata": "0.2.2",
    "rocketmq-client-nodejs": "1.0.7",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "prisma": "7.10.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
