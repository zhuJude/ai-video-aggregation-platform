{
  "name": "@repo/identity-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json && node scripts/copy-prisma-runtime.mjs && node scripts/probe-prisma-runtime.mjs",
    "dev": "prisma generate && tsc -p tsconfig.json --watch --preserveWatchOutput",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint src test scripts prisma.config.ts --ignore-pattern src/generated/prisma/**",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude dist/**",
    "test:coverage": "vitest run --coverage --exclude dist/**",
    "verify:prisma-build": "node scripts/verify-prisma-build.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm verify:prisma-build"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "fastify": "5.12.1",
    "ioredis": "6.0.0",
    "jose": "6.2.10",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "prisma": "7.10.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
