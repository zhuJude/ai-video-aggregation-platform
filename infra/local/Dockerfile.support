FROM node:24.15.0-alpine
WORKDIR /app
COPY infra/local/support-server.mjs ./support-server.mjs
USER node
EXPOSE 8080
HEALTHCHECK --interval=5s --timeout=2s --start-period=2s --retries=10 CMD node -e "fetch('http://127.0.0.1:8080/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "support-server.mjs"]
