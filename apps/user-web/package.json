{
  "name": "@repo/user-web",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "24.15.0"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "overrides": [
      {
        "files": "next-env.d.ts",
        "options": {
          "singleQuote": false
        }
      }
    ]
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "e2e": "playwright test",
    "lint": "eslint .",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --environment jsdom",
    "test:coverage": "vitest run --coverage --environment jsdom"
  },
  "dependencies": {
    "@repo/capability-schema": "workspace:*",
    "@repo/contracts": "workspace:*",
    "ajv": "8.20.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.1",
    "jsdom": "30.0.1",
    "tsx": "4.23.12"
  }
}
