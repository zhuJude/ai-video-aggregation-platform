{
  "name": "@repo/user-web",
  "version": "0.0.0",
  "private": true,
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "overrides": [
      {
        "files": "next-env.d.ts",
        "options": {
          "singleQuote": false
        }
      }
    ]
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint .",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --environment jsdom",
    "test:coverage": "vitest run --coverage --environment jsdom"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "30.0.1"
  }
}
